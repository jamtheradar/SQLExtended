<Solution>
  <Project Path="SQLExtended.Tests/SQLExtended.Tests.csproj" />
  <Project Path="SQLExtended/SQLExtended.csproj" />
  <Project Path="SchemaCompare/SchemaCompare.csproj" />
  <Project Path="SchemaExporter/SchemaExporter.csproj" />
  <!-- _SolutionDocs is a container for documentation, not code: it exists so the .md files and CLAUDE.md
       show up in Solution Explorer. Excluded from the build in every solution configuration, which is the
       .slnx spelling of unticking Build in Configuration Manager. Without this it compiles an empty
       net10.0 assembly on every solution build. Restore still touches it, so obj/ appears; only the
       compile is skipped. -->
  <Project Path="SoluitionDocs/_SolutionDocs.csproj">
    <Build Solution="*|*" Project="false" />
  </Project>
</Solution>
