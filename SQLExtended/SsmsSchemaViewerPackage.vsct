    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="RefreshCacheCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextCacheGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="SchemaCacheCommandId" priority="0x0110">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextCacheGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSettingsGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="FormatOptionsCommandId" priority="0x0110">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSettingsGroup"/>
