    <!-- Toolbar: Refresh Cache button -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="RefreshCacheCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCacheGroup"/>
    </CommandPlacement>

    <!-- Toolbar: SQL Search button -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="SqlSearchCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCommandsGroup"/>
    </CommandPlacement>
    <!-- Toolbar: Format SQL button -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="FormatSqlCommandId" priority="0x0200">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCommandsGroup"/>
    </CommandPlacement>

    <!-- Toolbar: Settings button -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="ToolbarSettingsGroup"/>
