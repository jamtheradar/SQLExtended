      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextToolsGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="SchemaValidateCommandId" priority="0x0130">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextToolsGroup"/>
