    <!-- The "SQL Query Editor" key binding scope, as Tools > Options > Keyboard lists it (CurrentSettings.vssettings
         ScopeDefinitions). More specific than Text Editor, so a binding here beats a Text Editor one on the same chord. -->
    <GuidSymbol name="guidSqlQueryEditorScope" value="{B5A506EB-11BE-4782-9A18-21265C2CA0B4}" />
  </Symbols>

