    <!-- SQLEditors' command set that owns the query editor / results pane context menus.
         GUID and menu ID verified against SSMS 22's SQLWorkbenchCommands type. -->
    <GuidSymbol name="guidSQLEditorGroup" value="{33F13AC3-80BB-4ecb-85BC-225435603A5E}">
