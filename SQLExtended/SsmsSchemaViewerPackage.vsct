<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidSsmsSchemaViewerPackage">

    <Menus>
      <!-- Top-level "SQLExtended" menu on the main menu bar -->
      <Menu guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu" priority="0x0600" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS"/>
        <CommandFlag>AlwaysCreate</CommandFlag>
        <Strings>
          <ButtonText>SQLExtended</ButtonText>
        </Strings>
      </Menu>

      <!-- SQLExtended toolbar -->
      <Menu guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedToolbar" type="Toolbar" priority="0x0000">
        <Strings>
          <ButtonText>SQLExtended</ButtonText>
        </Strings>
      </Menu>

      <!-- "SQLExtended" submenu on the query editor's right-click menu: the editor commands, the tool windows and the
           settings, so what is otherwise reachable only by shortcut can be found by right-clicking. -->
      <Menu guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextMenuGroup"/>
        <Strings>
          <ButtonText>SQLExtended</ButtonText>
        </Strings>
      </Menu>
      <!-- "Highlight Tab" submenu on the document tab's right-click menu (EnvTabs/TabHighlightCommand.cs) -->
      <Menu guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabContextGroup"/>
        <Strings>
          <ButtonText>Highlight Tab</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- SQLExtended menu groups, in display order. MainMenuService.Items builds the menu SSMS 22
           actually shows; keep the two in the same order. -->
      <!-- Query editor actions -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" priority="0x0100">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Tool windows -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSearchGroup" priority="0x0200">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Results grid -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedGridGroup" priority="0x0300">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Monitoring dashboards -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMonitoringGroup" priority="0x0400">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Schema cache -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedCacheGroup" priority="0x0500">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Servers and connections -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedServersGroup" priority="0x0600">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Settings -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsGroup" priority="0x0700">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenu"/>
      </Group>

      <!-- Group on the query editor's right-click menu, holding the SQLExtended submenu. The parent is SQLEditors' own
           IDM_SQLWB_SQLSCRIPT_CONTEXT, not the shell's IDM_VS_CTXT_CODEWIN: SSMS's query window shows its own menu, and a
           placement on the code-window menu merges without error and never appears. -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="EditorContextMenuGroup" priority="0x0600">
        <Parent guid="guidSQLEditorGroup" id="IDM_SQLWB_SQLSCRIPT_CONTEXT"/>
      </Group>
      <!-- Groups inside that submenu, in display order -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup" priority="0x0100">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSubMenu"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="EditorContextToolsGroup" priority="0x0200">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSubMenu"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="EditorContextCacheGroup" priority="0x0300">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSubMenu"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSettingsGroup" priority="0x0400">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextSubMenu"/>
      </Group>
      <!-- Group on the Messages pane's right-click menu: Parse Statistics reads that pane -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="MessagesContextGroup" priority="0x0700">
        <Parent guid="guidSQLEditorGroup" id="IDM_SQLWB_SQLRESMSG_CONTEXT"/>
      </Group>

      <!-- Group on the results grid context (right-click) menu. The parent is SQLEditors'
           IDM_SQLWB_SQLRESGRID_CONTEXT menu in the GUID_SQLEditorGroup command set (values
           extracted from SSMS 22's SQLWorkbenchCommands). -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="ResultsGridContextGroup" priority="0x0700">
        <Parent guid="guidSQLEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT"/>
      </Group>

      <!-- Group on the document tab's right-click menu, and the two groups inside its Highlight Tab submenu -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="TabContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_EZDOCWINTAB"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" priority="0x0100">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightMenu"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightClearGroup" priority="0x0200">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightMenu"/>
      </Group>

      <!-- Toolbar groups -->
      <Group guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCacheGroup" priority="0x0100">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedToolbar"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCommandsGroup" priority="0x0200">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedToolbar"/>
      </Group>
      <Group guid="guidSsmsSchemaViewerCmdSet" id="ToolbarSettingsGroup" priority="0x0300">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedToolbar"/>
      </Group>
    </Groups>

    <Buttons>
      <!-- View Schema command — appears in SQLExtended menu, context menu, and has a keyboard shortcut -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SchemaViewerCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>View Schema</ButtonText>
          <ToolTipText>Show the CREATE TABLE script and indexes for the object under the cursor (Ctrl+Shift+D)</ToolTipText>
        </Strings>
      </Button>

      <!-- Open Definition — the object under the cursor straight into a new query window, no preview (issue #6) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="OpenDefinitionCommandId" priority="0x0102" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Open Definition</ButtonText>
          <ToolTipText>Script the object under the cursor into a new query window on the same server and database (F12)</ToolTipText>
        </Strings>
      </Button>

      <!-- Locate in Object Explorer — expand Object Explorer to the object under the cursor (issue #7) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="LocateInObjectExplorerCommandId" priority="0x0104" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Locate in Object Explorer</ButtonText>
          <ToolTipText>Expand Object Explorer to the object under the cursor and select it (Ctrl+F12)</ToolTipText>
        </Strings>
      </Button>

      <!-- Format SQL command — formats selected text or entire document -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatSqlCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Format SQL</ButtonText>
          <ToolTipText>Format the selected SQL or entire document (Ctrl+K, Ctrl+Y)</ToolTipText>
        </Strings>
      </Button>

      <!-- Format Selection — formats only the statements the selection touches, at their own indent (issue #8) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatSelectionCommandId" priority="0x0112" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Format Selection</ButtonText>
          <ToolTipText>Format only the statements the selection touches, or the one under the caret (Ctrl+K, Ctrl+Shift+F)</ToolTipText>
        </Strings>
      </Button>

      <!-- Format With... — tick rules for one run, or manage the presets (issue #8) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatWithCommandId" priority="0x0113" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Format With...</ButtonText>
          <ToolTipText>Apply only the formatting rules you choose, or a saved preset</ToolTipText>
        </Strings>
      </Button>

      <!-- Single Format With rules on their own commands, at SQL Prompt's Ctrl+B chords -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="UppercaseKeywordsCommandId" priority="0x0113" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Uppercase Keywords</ButtonText>
          <ToolTipText>Uppercase keywords and built-in function names, leaving the layout alone (Ctrl+B, Ctrl+U)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="RemoveBracketsCommandId" priority="0x0113" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Remove Brackets</ButtonText>
          <ToolTipText>Remove square brackets that are not needed (Ctrl+B, Ctrl+B)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="InsertSemicolonsCommandId" priority="0x0113" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Insert Semicolons</ButtonText>
          <ToolTipText>Add a semicolon to every statement that lacks one (Ctrl+B, Ctrl+C)</ToolTipText>
        </Strings>
      </Button>

      <!-- Format Preset 1-5 - apply a saved Format With preset with no dialog. CommandWellOnly: no menu entry, only a
           name to bind a shortcut to under Tools > Options > Keyboard (SQLExtended.FormatPreset1...). -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatPreset1CommandId" priority="0x0114" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Format Preset 1</ButtonText>
          <CanonicalName>SQLExtended.FormatPreset1</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatPreset2CommandId" priority="0x0114" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Format Preset 2</ButtonText>
          <CanonicalName>SQLExtended.FormatPreset2</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatPreset3CommandId" priority="0x0114" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Format Preset 3</ButtonText>
          <CanonicalName>SQLExtended.FormatPreset3</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatPreset4CommandId" priority="0x0114" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Format Preset 4</ButtonText>
          <CanonicalName>SQLExtended.FormatPreset4</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatPreset5CommandId" priority="0x0114" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Format Preset 5</ButtonText>
          <CanonicalName>SQLExtended.FormatPreset5</CanonicalName>
        </Strings>
      </Button>

      <!-- Qualify Columns — aliases the tables and prefixes every column with its table's alias (issue #3) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="QualifyColumnsCommandId" priority="0x0115" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Qualify Columns</ButtonText>
          <ToolTipText>Alias every table and prefix each column with its table's alias, in the selection or entire document (Ctrl+B, Ctrl+Q)</ToolTipText>
        </Strings>
      </Button>

      <!-- Align On — lines a token (AS, ON, =, ...) up across the selected lines (issue #8) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="AlignOnCommandId" priority="0x0116" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Align On...</ButtonText>
          <ToolTipText>Line up AS, ON, = or any token across the selected lines (Ctrl+=)</ToolTipText>
        </Strings>
      </Button>

      <!-- Formatter command — opens the formatter settings dialog -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="FormatOptionsCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsGroup" />
        <Strings>
          <ButtonText>Formatter...</ButtonText>
          <ToolTipText>Configure SQL formatting options</ToolTipText>
        </Strings>
      </Button>

      <!-- Snippets command — opens SQLExtended Settings on the Snippets tab -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SnippetsCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsGroup" />
        <Strings>
          <ButtonText>Snippets...</ButtonText>
          <ToolTipText>Manage SQL code snippets</ToolTipText>
        </Strings>
      </Button>

      <!-- Refresh Cache command — refreshes schema cache for the current database -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="RefreshCacheCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedCacheGroup" />
        <Strings>
          <ButtonText>Refresh Schema Cache</ButtonText>
          <ToolTipText>Refresh the schema cache for the current database (Ctrl+Shift+R)</ToolTipText>
        </Strings>
      </Button>

      <!-- Refresh All Databases cache -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="RefreshAllCacheCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedCacheGroup" />
        <Strings>
          <ButtonText>Refresh All Databases</ButtonText>
          <ToolTipText>Refresh the schema cache for all connected databases</ToolTipText>
        </Strings>
      </Button>

      <!-- Clear Cache command -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="ClearCacheCommandId" priority="0x0130" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedCacheGroup" />
        <Strings>
          <ButtonText>Clear Schema Cache</ButtonText>
          <ToolTipText>Clear all cached schema data</ToolTipText>
        </Strings>
      </Button>

      <!-- Schema Cache command — opens the dockable cache inspector tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SchemaCacheCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedCacheGroup" />
        <Strings>
          <ButtonText>Schema Cache...</ButtonText>
          <ToolTipText>View what schema is cached per server (Ctrl+Alt+C)</ToolTipText>
        </Strings>
      </Button>

      <!-- SQL Search command — opens the dockable search tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SqlSearchCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSearchGroup" />
        <Strings>
          <ButtonText>SQL Search</ButtonText>
          <ToolTipText>Search database objects, columns, and definitions (Ctrl+Alt+F)</ToolTipText>
        </Strings>
      </Button>

      <!-- Validate Schema References command — opens the dockable validation tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SchemaValidateCommandId" priority="0x0130" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSearchGroup" />
        <Strings>
          <ButtonText>Validate Schema References</ButtonText>
          <ToolTipText>Find broken object, cross-database, and linked-server references (Ctrl+Alt+V)</ToolTipText>
        </Strings>
      </Button>

      <!-- SQL History command — opens the dockable history tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SqlHistoryCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSearchGroup" />
        <Strings>
          <ButtonText>SQL History</ButtonText>
          <ToolTipText>Browse captured snapshots of recently edited SQL tabs (Ctrl+Alt+H)</ToolTipText>
        </Strings>
      </Button>

      <!-- Script Library command — opens the dockable script library tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="ScriptLibraryCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSearchGroup" />
        <Strings>
          <ButtonText>Script Library</ButtonText>
          <ToolTipText>Browse and run curated and personal T-SQL scripts (Ctrl+Alt+L)</ToolTipText>
        </Strings>
      </Button>

      <!-- Parse Statistics command — parses the Messages pane into the Statistics tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="StatisticsCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMenuGroup" />
        <Strings>
          <ButtonText>Parse Statistics</ButtonText>
          <ToolTipText>Parse the Messages pane's STATISTICS IO/TIME output into sortable tables (Ctrl+K, Ctrl+G)</ToolTipText>
        </Strings>
      </Button>

      <!-- Performance Monitor — opens the dockable live performance dashboard -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="PerfMonitorCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMonitoringGroup" />
        <Strings>
          <ButtonText>Performance Monitor</ButtonText>
          <ToolTipText>Live server dashboard: CPU, waits, blocking, active requests, top queries and file latency (Ctrl+Alt+P)</ToolTipText>
        </Strings>
      </Button>

      <!-- Always On Monitor — opens the dockable availability-group monitor tool window -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="AgMonitorCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMonitoringGroup" />
        <Strings>
          <ButtonText>Always On Monitor</ButtonText>
          <ToolTipText>Monitor availability groups: replica health, send/redo queues, lag, seeding progress and errors (Ctrl+Alt+A)</ToolTipText>
        </Strings>
      </Button>

      <!-- Agent Jobs — opens the dockable SQL Server Agent jobs dashboard -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="JobsMonitorCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMonitoringGroup" />
        <Strings>
          <ButtonText>Agent Jobs</ButtonText>
          <ToolTipText>Live SQL Server Agent job list: last outcome, durations, next run, running step, owner and notification e-mail (Ctrl+Alt+J)</ToolTipText>
        </Strings>
      </Button>

      <!-- Replication Monitor — opens the dockable replication dashboard -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="ReplMonitorCommandId" priority="0x0130" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedMonitoringGroup" />
        <Strings>
          <ButtonText>Replication Monitor</ButtonText>
          <ToolTipText>Monitor replication: publication and subscription health, end-to-end latency, agent status and errors, pending commands, tracer tokens and publisher log growth (Ctrl+Alt+R)</ToolTipText>
        </Strings>
      </Button>

      <!-- SQLExtended Settings command — opens unified settings dialog -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsGroup" />
        <Strings>
          <ButtonText>SQLExtended Settings...</ButtonText>
          <ToolTipText>Configure SQLExtended extension settings</ToolTipText>
        </Strings>
      </Button>

      <!-- Environment Tabs command — colour and rename query tabs by connection -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="EnvTabsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedServersGroup" />
        <Strings>
          <ButtonText>Environment Tabs...</ButtonText>
          <ToolTipText>Colour and rename query tabs by the server and database they are connected to</ToolTipText>
        </Strings>
      </Button>

      <!-- Highlight Tab submenu. Colours are palette indices mapped in TabHighlightCommand.Colors. -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightRoseCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Rose</ButtonText>
          <ToolTipText>Colour this tab rose until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightPumpkinCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Pumpkin</ButtonText>
          <ToolTipText>Colour this tab pumpkin until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightGoldCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Gold</ButtonText>
          <ToolTipText>Colour this tab gold until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightVoltCommandId" priority="0x0130" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Volt</ButtonText>
          <ToolTipText>Colour this tab volt until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightGreenCommandId" priority="0x0140" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Green</ButtonText>
          <ToolTipText>Colour this tab green until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightSkyCommandId" priority="0x0150" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Sky</ButtonText>
          <ToolTipText>Colour this tab sky until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightMagentaCommandId" priority="0x0160" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightColorGroup" />
        <Strings>
          <ButtonText>Magenta</ButtonText>
          <ToolTipText>Colour this tab magenta until cleared or closed</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightClearCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="TabHighlightClearGroup" />
        <Strings>
          <ButtonText>Clear Highlight</ButtonText>
          <ToolTipText>Remove this tab's highlight; its environment colour, if any, returns</ToolTipText>
        </Strings>
      </Button>

      <!-- Check for Updates command -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="CheckForUpdatesCommandId" priority="0x0130" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedSettingsGroup" />
        <Strings>
          <ButtonText>Check for Updates...</ButtonText>
          <ToolTipText>Check the SQLExtended feed for a newer version</ToolTipText>
        </Strings>
      </Button>

      <!-- Script Results as INSERT — in the results grid right-click menu -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="ScriptResultsInsertCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="ResultsGridContextGroup" />
        <Strings>
          <ButtonText>Script Results as INSERT</ButtonText>
          <ToolTipText>Generate a temp table and INSERT statements from this results grid</ToolTipText>
        </Strings>
      </Button>

      <!-- Grid Aggregates — in the results grid right-click menu, where a range has just been selected -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="GridAggregatesCommandId" priority="0x0110" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="ResultsGridContextGroup" />
        <Strings>
          <ButtonText>Grid Aggregates</ButtonText>
          <ToolTipText>Sum, average, min, max, distinct and null counts for the selected cells (Ctrl+Alt+G)</ToolTipText>
        </Strings>
      </Button>

      <!-- Find in Results — in the results grid right-click menu, beside Grid Aggregates -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="GridFindCommandId" priority="0x0120" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="ResultsGridContextGroup" />
        <Strings>
          <ButtonText>Find in Results</ButtonText>
          <ToolTipText>Find text in this results grid and step through the matches (Ctrl+Alt+S)</ToolTipText>
        </Strings>
      </Button>

      <!-- Go to Column — in the results grid right-click menu, beside Find in Results -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="GoToColumnCommandId" priority="0x0125" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="ResultsGridContextGroup" />
        <Strings>
          <ButtonText>Go to Column...</ButtonText>
          <ToolTipText>Type part of a column name and jump to that column in this results grid (Ctrl+Alt+K)</ToolTipText>
        </Strings>
      </Button>

      <!-- Copy as IN Filter — the selected cells of one column as IN (...) (issue #5) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="CopyAsInFilterCommandId" priority="0x0105" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="ResultsGridContextGroup" />
        <Strings>
          <ButtonText>Copy as IN Filter</ButtonText>
          <ToolTipText>Copy the selected cells of one column as an IN (...) list (Ctrl+Shift+I)</ToolTipText>
        </Strings>
      </Button>

      <!-- Toolbar: Cache status indicator (read-only display text) -->
      <Button guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCacheStatusId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsSchemaViewerCmdSet" id="ToolbarCacheGroup" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DontCache</CommandFlag>
        <Strings>
          <ButtonText>Schema: Not loaded</ButtonText>
          <ToolTipText>Schema cache status</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <!-- Place commands in the editor context menu and toolbar -->
  <CommandPlacements>
    <!-- Results grid commands also appear in the SQLExtended menu -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="GridFindCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedGridGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="GoToColumnCommandId" priority="0x0105">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedGridGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="GridAggregatesCommandId" priority="0x0110">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedGridGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="CopyAsInFilterCommandId" priority="0x0115">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedGridGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="ScriptResultsInsertCommandId" priority="0x0120">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="SQLExtendedGridGroup"/>
    </CommandPlacement>

    <!-- Query editor right-click > SQLExtended -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="SchemaViewerCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="OpenDefinitionCommandId" priority="0x0102">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="LocateInObjectExplorerCommandId" priority="0x0104">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="FormatSqlCommandId" priority="0x0110">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="FormatSelectionCommandId" priority="0x0115">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="FormatWithCommandId" priority="0x0117">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="UppercaseKeywordsCommandId" priority="0x0118">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="RemoveBracketsCommandId" priority="0x0119">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="EditorContextEditGroup"/>
