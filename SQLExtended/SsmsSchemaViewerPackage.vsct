  </CommandPlacements>

  <!-- Editor commands are bound twice: in the SQL Query Editor scope, and in Global.
       A Global binding loses to a Text Editor one on the same chord once the caret is in a query window - Ctrl+K, Ctrl+F
       is Edit.FormatSelection there and Ctrl+K, Ctrl+A is Edit.SwapAnchor - and the shortcut silently does something else.
       SQL Query Editor is more specific than Text Editor, so the binding there wins. The Global copy covers focus in the
       results / Messages pane (Parse Statistics reads Messages), which may sit outside that scope.
       Tool-window shortcuts (Ctrl+Alt+...) stay Global only: they are wanted from Object Explorer too. -->
  <KeyBindings>
    <!-- Ctrl+Shift+D: View Schema -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SchemaViewerCommandId"
                editor="guidSqlQueryEditorScope"
                key1="D"
                mod1="Control Shift"/>
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SchemaViewerCommandId"
                editor="guidVSStd97"
                key1="D"
                mod1="Control Shift"/>

    <!-- F12: Open Definition, as Go to Definition is in Visual Studio. Query windows only: F12 means nothing to this
         command anywhere else, and Global F12 is the shell's own Edit.GoToDefinition. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="OpenDefinitionCommandId"
                editor="guidSqlQueryEditorScope"
                key1="VK_F12"/>

    <!-- Where Redgate SQL Prompt has the same command, it has the same chord (its quick reference guide): F12 above,
         Ctrl+F12, Ctrl+K, Ctrl+Y, and the Ctrl+B family. People who move from Prompt bring these with them. All are bound
         in the SQL Query Editor scope only - each command works on the query window, and that scope beats the Text
         Editor bindings VS gives some of these keys (Ctrl+F12 is Edit.GoToDeclaration there). -->

    <!-- Ctrl+F12: Locate in Object Explorer (Prompt: Select in Object Explorer). -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="LocateInObjectExplorerCommandId"
                editor="guidSqlQueryEditorScope"
                key1="VK_F12"
                mod1="Control"/>

    <!-- Ctrl+K, Ctrl+Y: Format SQL (Prompt: Format SQL). -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="FormatSqlCommandId"
                editor="guidSqlQueryEditorScope"
                key1="K"
                mod1="Control"
                key2="Y"
                mod2="Control"/>

    <!-- Ctrl+K, Ctrl+Shift+F: Format Selection. No Prompt equivalent; kept as it was. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="FormatSelectionCommandId"
                editor="guidSqlQueryEditorScope"
                key1="K"
                mod1="Control"
                key2="F"
                mod2="Control Shift"/>

    <!-- Ctrl+B, Ctrl+Q: Qualify Columns (Prompt: Qualify object names). -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="QualifyColumnsCommandId"
                editor="guidSqlQueryEditorScope"
                key1="B"
                mod1="Control"
                key2="Q"
                mod2="Control"/>

    <!-- Ctrl+B, Ctrl+U: Uppercase Keywords (Prompt: Uppercase keywords). -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="UppercaseKeywordsCommandId"
                editor="guidSqlQueryEditorScope"
                key1="B"
                mod1="Control"
                key2="U"
                mod2="Control"/>

    <!-- Ctrl+B, Ctrl+B: Remove Brackets (Prompt: Add/remove square brackets - ours only removes the unneeded ones). -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="RemoveBracketsCommandId"
                editor="guidSqlQueryEditorScope"
                key1="B"
                mod1="Control"
                key2="B"
                mod2="Control"/>

    <!-- Ctrl+B, Ctrl+C: Insert Semicolons (Prompt: Insert semicolons). -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="InsertSemicolonsCommandId"
                editor="guidSqlQueryEditorScope"
                key1="B"
                mod1="Control"
                key2="C"
                mod2="Control"/>

    <!-- Ctrl+=: Align On, CodeAlignment's chord (the extension issue #8 points to). Query windows only, like Qualify Columns. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="AlignOnCommandId"
                editor="guidSqlQueryEditorScope"
                key1="VK_OEM_PLUS"
                mod1="Control"/>

    <!-- Ctrl+Shift+R: Refresh Schema Cache (takes the chord from SSMS's Refresh IntelliSense Local Cache, same job) -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="RefreshCacheCommandId"
                editor="guidSqlQueryEditorScope"
                key1="R"
                mod1="Control Shift"/>
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="RefreshCacheCommandId"
                editor="guidVSStd97"
                key1="R"
                mod1="Control Shift"/>

    <!-- Ctrl+Alt+F for SQL Search. SSMS 22's Copilot extension (SSMSAgent) binds Ctrl+Alt+F Global to Copilot "Fix", and
         the shell gives the Global chord to it. Bound in the SQL Query Editor scope as well, which wins in a query window;
         elsewhere (Object Explorer) Copilot keeps it unless the user reassigns it. SSMSAgent also has Ctrl+Alt+D, E and R. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SqlSearchCommandId"
                editor="guidSqlQueryEditorScope"
                key1="F"
                mod1="Control Alt"/>
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SqlSearchCommandId"
                editor="guidVSStd97"
                key1="F"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+C for Schema Cache -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SchemaCacheCommandId"
                editor="guidVSStd97"
                key1="C"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+V for Validate Schema References -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SchemaValidateCommandId"
                editor="guidVSStd97"
                key1="V"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+H for SQL History -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="SqlHistoryCommandId"
                editor="guidVSStd97"
                key1="H"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+L for Script Library -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="ScriptLibraryCommandId"
                editor="guidVSStd97"
                key1="L"
                mod1="Control Alt"/>

    <!-- Chord shortcut: Ctrl+K, Ctrl+G for Parse Statistics (matches the upstream Statistics Parser extension) -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="StatisticsCommandId"
                editor="guidSqlQueryEditorScope"
                key1="K"
                mod1="Control"
                key2="G"
                mod2="Control"/>
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="StatisticsCommandId"
                editor="guidVSStd97"
                key1="K"
                mod1="Control"
                key2="G"
                mod2="Control"/>

    <!-- Ctrl+Alt+A for Always On Monitor -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="AgMonitorCommandId"
                editor="guidVSStd97"
                key1="A"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+P for Performance Monitor -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="PerfMonitorCommandId"
                editor="guidVSStd97"
                key1="P"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+J for Agent Jobs -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="JobsMonitorCommandId"
                editor="guidVSStd97"
                key1="J"
                mod1="Control Alt"/>

    <!-- No shortcut for Replication Monitor: Ctrl+Alt+R belongs to Copilot "Optimize" (SSMSAgent) and the menu item is enough. -->

    <!-- Ctrl+Alt+G for Grid Aggregates -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="GridAggregatesCommandId"
                editor="guidVSStd97"
                key1="G"
                mod1="Control Alt"/>

    <!-- Ctrl+Alt+S for Find in Results. Not Ctrl+F (the editor's own find) and not Ctrl+Alt+F,
         which SQL Search already claims. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="GridFindCommandId"
                editor="guidVSStd97"
                key1="S"
                mod1="Control Alt"/>
    <!-- Ctrl+Alt+K for Go to Column. Ctrl+Alt+O is SSMS's Output window, and E, I, M and Q are the debugger's. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="GoToColumnCommandId"
                editor="guidVSStd97"
                key1="K"
                mod1="Control Alt"/>
    <!-- Ctrl+Shift+I for Copy as IN Filter (the chord issue #5 suggests). It takes the chord over from
         Edit.ReverseIncrementalSearch, so it is bound in the SQL Query Editor scope as well as Global: the Text Editor
         binding would otherwise win in a query window. -->
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="CopyAsInFilterCommandId"
                editor="guidSqlQueryEditorScope"
                key1="I"
                mod1="Control Shift"/>
    <KeyBinding guid="guidSsmsSchemaViewerCmdSet"
                id="CopyAsInFilterCommandId"
                editor="guidVSStd97"
                key1="I"
                mod1="Control Shift"/>
  </KeyBindings>

