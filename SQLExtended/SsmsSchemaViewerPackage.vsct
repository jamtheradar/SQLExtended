    <!-- Messages pane right-click -->
    <CommandPlacement guid="guidSsmsSchemaViewerCmdSet" id="StatisticsCommandId" priority="0x0100">
      <Parent guid="guidSsmsSchemaViewerCmdSet" id="MessagesContextGroup"/>
