<Window x:Class="SQLExtended.Align.AlignOnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align On"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SqlxSurfaceRaised}"
        BorderBrush="{DynamicResource SqlxBorderStrong}"
        BorderThickness="1"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="TokenBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SqlxSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource SqlxText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource SqlxText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SqlxAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Item chrome drawn here rather than left to the system theme, whose selection colours ignore SSMS's. -->
        <Style x:Key="PresetItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SqlxText}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SqlxRowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SqlxSelection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SqlxSelectionText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,6">
            <TextBlock DockPanel.Dock="Right" Text="Esc close" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="Align on" Foreground="{DynamicResource SqlxHeading}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBox x:Name="TokenBox" Grid.Row="1" Style="{StaticResource TokenBoxStyle}"
                 TextChanged="TokenBox_TextChanged" PreviewKeyDown="TokenBox_PreviewKeyDown"/>

        <ListBox x:Name="PresetList" Grid.Row="2" Margin="0,6,0,0"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource PresetItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="PresetList_SelectionChanged"
                 MouseDoubleClick="PresetList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Token}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SqlxSynFunction}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="2,6,2,0" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" TextWrapping="Wrap"
                   Text="Enter: first on each line · Shift+Enter: every occurrence"/>
    </Grid>
</Window>
