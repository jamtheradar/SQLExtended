<Window x:Class="SQLExtended.SchemaCompare.UI.ScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Change script — Schema Compare" Height="760" Width="1080" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SqlxSurface}" Foreground="{DynamicResource SqlxText}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSave" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- ===== What to script ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SqlxSurfaceRaised}" BorderBrush="{DynamicResource SqlxDivider}" BorderThickness="0,0,0,1" Padding="14,10,14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="OnCopy" ToolTip="Copy the whole script">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Click="OnSave" Margin="8,0,0,0" ToolTip="Save the script as a .sql file (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Save…" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="MAKE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SqlxTextSubtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LeftToRight" Style="{StaticResource Segment}" GroupName="Direction" Checked="OnOptionChanged" Content="Right like left" />
                            <RadioButton x:Name="RightToLeft" Style="{StaticResource Segment}" GroupName="Direction" Checked="OnOptionChanged" Content="Left like right" />
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="IncludeDrops" Content="Drop objects only on the target" VerticalAlignment="Center" Margin="0,0,18,0" Click="OnOptionChanged"
                              ToolTip="Off: objects the target has and the source doesn't are left alone, and listed at the top of the script." />
                    <CheckBox x:Name="UseTransaction" Content="Wrap in a transaction" VerticalAlignment="Center" Click="OnOptionChanged"
                              ToolTip="All or nothing: the first error rolls everything back and the batches after it don't run." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SqlxSurfaceRaised}" BorderBrush="{DynamicResource SqlxDivider}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="WarningText" DockPanel.Dock="Right" Foreground="{DynamicResource SqlxWarn}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SqlxTextChrome}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource SqlxSurfaceAlt}" Padding="14,5">
            <TextBlock x:Name="TargetText" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
        </Border>

        <ae:TextEditor x:Name="Editor" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13" ShowLineNumbers="True" Padding="6,0,0,0"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
