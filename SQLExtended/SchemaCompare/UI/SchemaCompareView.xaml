<UserControl x:Class="SQLExtended.SchemaCompare.UI.SchemaCompareView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SQLExtended.SchemaCompare.UI"
        Background="{DynamicResource SqlxSurface}" Foreground="{DynamicResource SqlxText}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True" Focusable="True">

    <!-- The control templates are scoped to this view, never put in Application resources: inside SSMS that would
         restyle every WPF control in the shell. Colours come from the host (ThemeManager / AppTheme). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static ui:Commands.Compare}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{x:Static ui:Commands.NextDifference}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{x:Static ui:Commands.PreviousDifference}" />
        <KeyBinding Key="F8" Command="{x:Static ui:Commands.NextDifference}" />
        <KeyBinding Key="F8" Modifiers="Shift" Command="{x:Static ui:Commands.PreviousDifference}" />
        <KeyBinding Key="Down" Modifiers="Ctrl+Alt" Command="{x:Static ui:Commands.NextObject}" />
        <KeyBinding Key="Up" Modifiers="Ctrl+Alt" Command="{x:Static ui:Commands.PreviousObject}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static ui:Commands.Compare}" Executed="OnCompare" />
        <CommandBinding Command="{x:Static ui:Commands.NextDifference}" Executed="OnNextDifference" />
        <CommandBinding Command="{x:Static ui:Commands.PreviousDifference}" Executed="OnPreviousDifference" />
        <CommandBinding Command="{x:Static ui:Commands.NextObject}" Executed="OnNextObject" />
        <CommandBinding Command="{x:Static ui:Commands.PreviousObject}" Executed="OnPreviousObject" />
    </UserControl.CommandBindings>

    <DockPanel>
        <!-- ===== Sources ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SqlxSurfaceRaised}" BorderBrush="{DynamicResource SqlxDivider}" BorderThickness="0,0,0,1" Padding="14,10,14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left source -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="LEFT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SqlxTextSubtle}" Margin="2,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnDatabaseLeft" ToolTip="Choose a SQL Server database" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnBrowseLeft" ToolTip="Choose a folder" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" />
                        </Button>
                        <ComboBox x:Name="LeftPath" IsEditable="True"
                                  ToolTip="An export folder, a database project folder or .sqlproj, any folder of .sql files, or a live database as mssql://server/database" />
                    </DockPanel>
                    <TextBlock x:Name="LeftInfo" Style="{StaticResource Muted}" Margin="2,5,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="OnSwap" ToolTip="Swap left and right" Margin="10,19,10,0" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" />
                </Button>

                <!-- Right source -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RIGHT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SqlxTextSubtle}" Margin="2,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnDatabaseRight" ToolTip="Choose a SQL Server database" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnBrowseRight" ToolTip="Choose a folder" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" />
                        </Button>
                        <ComboBox x:Name="RightPath" IsEditable="True"
                                  ToolTip="An export folder, a database project folder or .sqlproj, any folder of .sql files, or a live database as mssql://server/database" />
                    </DockPanel>
                    <TextBlock x:Name="RightInfo" Style="{StaticResource Muted}" Margin="2,5,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="CompareButton" Grid.Column="3" Style="{StaticResource AccentButton}" Click="OnCompare" Margin="16,19,0,0" VerticalAlignment="Top"
                        ToolTip="Read both sides and compare (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Compare" />
                    </StackPanel>
                </Button>

                <Button x:Name="ScriptButton" Grid.Column="4" Style="{StaticResource GhostButton}" Click="OnScriptChanges" Margin="8,19,0,0" VerticalAlignment="Top" IsEnabled="False"
                        ToolTip="Write the T-SQL that makes one side like the other, for the differences shown in the list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Change script" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SqlxSurfaceRaised}" BorderBrush="{DynamicResource SqlxDivider}" BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel>
                <Border x:Name="ThemeSwitch" DockPanel.Dock="Right" BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Margin="12,2,0,2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSsms" Style="{StaticResource Segment}" GroupName="Theme" Checked="OnThemeChosen" Content="SSMS" />
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme" Checked="OnThemeChosen" ToolTip="Light">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="12" />
                        </RadioButton>
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme" Checked="OnThemeChosen" ToolTip="Dark">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="12" />
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11.5"
                           Text="Alt+↓/↑ difference   ·   Ctrl+Alt+↓/↑ object   ·   F5 compare" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SqlxTextChrome}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="OptionsColumn" Width="310" />
            </Grid.ColumnDefinitions>

            <!-- ===== Object list ===== -->
            <DockPanel Grid.Column="0" Background="{DynamicResource SqlxSurface}">
                <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                    <WrapPanel>
                        <CheckBox x:Name="ShowDifferent" IsChecked="True" Margin="0,0,14,6" Click="OnFilterChanged">
                            <TextBlock><Run Text="≠ " Foreground="{DynamicResource SqlxWarn}" FontWeight="Bold" /><Run x:Name="CountDifferent" Text="Different" /></TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="ShowLeftOnly" IsChecked="True" Margin="0,0,14,6" Click="OnFilterChanged">
                            <TextBlock><Run Text="◀ " Foreground="{DynamicResource SqlxBad}" FontWeight="Bold" /><Run x:Name="CountLeftOnly" Text="Left only" /></TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="ShowRightOnly" IsChecked="True" Margin="0,0,14,6" Click="OnFilterChanged">
                            <TextBlock><Run Text="▶ " Foreground="{DynamicResource SqlxGood}" FontWeight="Bold" /><Run x:Name="CountRightOnly" Text="Right only" /></TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="ShowIdentical" Margin="0,0,14,6" Click="OnFilterChanged">
                            <TextBlock><Run Text="= " Foreground="{DynamicResource SqlxTextMuted}" FontWeight="Bold" /><Run x:Name="CountIdentical" Text="Identical" /></TextBlock>
                        </CheckBox>
                    </WrapPanel>
                    <Grid Margin="0,2,0,0">
                        <TextBox x:Name="SearchBox" Padding="26,4,5,4" TextChanged="OnFilterChanged" Tag="Filter by name or type" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="9,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                                   Foreground="{DynamicResource SqlxTextMuted}" />
                    </Grid>
                </StackPanel>
                <ListView x:Name="ObjectList" SelectionMode="Single" SelectionChanged="OnObjectSelected"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open left file" Click="OnOpenLeftFile" Icon="&#xE8E5;" />
                            <MenuItem Header="Open right file" Click="OnOpenRightFile" Icon="&#xE8E5;" />
                            <Separator />
                            <MenuItem Header="Change script for this object…" Click="OnScriptObject" Icon="&#xE943;" />
                            <Separator />
                            <MenuItem Header="Copy name" Click="OnCopyName" Icon="&#xE8C8;" />
                            <MenuItem Header="Exclude this object" Click="OnExcludeObject" Icon="&#xE8F8;" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="28">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding StatusBrush}" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="{Binding StatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="84">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource SqlxTextSubtle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="210" DisplayMemberBinding="{Binding Name}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Margin="-3,0" BorderThickness="3,0" BorderBrush="Transparent" />

            <!-- ===== Diff ===== -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SqlxDivider}" BorderThickness="0,0,0,1" Padding="12,7,8,7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="HunkText" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                            <Button Style="{StaticResource GhostButton}" Click="OnPreviousDifference" ToolTip="Previous difference (Alt+Up)">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnNextDifference" ToolTip="Next difference (Alt+Down)">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" />
                            </Button>
                            <Border Width="1" Margin="8,6" Background="{DynamicResource SqlxDivider}" />
                            <Button x:Name="ScriptObjectButton" Style="{StaticResource GhostButton}" Click="OnScriptObject" Margin="0,0,4,0" IsEnabled="False"
                                    ToolTip="Write the change script for this object only">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Script" />
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="OriginalToggle" Style="{StaticResource GhostToggle}" Click="OnViewModeChanged"
                                          ToolTip="Show the scripts as written, instead of normalised with the ignore options applied">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Original" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="OptionsToggle" Style="{StaticResource GhostToggle}" Click="OnOptionsToggled" Margin="4,0,0,0" ToolTip="What counts as a difference">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Options" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StatusChip" CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="StatusChipText" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="ObjectType" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="ObjectTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SqlxTextStrong}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid DockPanel.Dock="Top" Background="{DynamicResource SqlxSurfaceAlt}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LeftFiles" Margin="10,4" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RightFiles" Grid.Column="2" Margin="10,4" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ui:DiffView x:Name="Diff" />
            </DockPanel>

            <!-- ===== Options ===== -->
            <Border x:Name="OptionsPanel" Grid.Column="3" BorderBrush="{DynamicResource SqlxDivider}" BorderThickness="1,0,0,0" Background="{DynamicResource SqlxSurfaceAlt}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,10,10,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnResetOptions" ToolTip="Put every option back to its default">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Defaults" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Ignore" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SqlxTextStrong}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OptionsHost" Margin="14,0,14,14" ToggleButton.Checked="OnOptionChanged" ToggleButton.Unchecked="OnOptionChanged">
                            <TextBlock Text="IN ALL SCRIPTS" Style="{StaticResource SectionHeader}" Margin="0,6,0,6" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Comments" IsChecked="{Binding IgnoreComments}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Whitespace and blank lines" IsChecked="{Binding IgnoreWhitespace}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Upper/lower case" IsChecked="{Binding IgnoreCase}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="[Square brackets] around names" IsChecked="{Binding IgnoreBrackets}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Statement-ending semicolons" IsChecked="{Binding IgnoreSemicolons}" />
                            <CheckBox Style="{StaticResource OptionBox}" IsChecked="{Binding IgnoreSessionSettings}">
                                <TextBlock TextWrapping="Wrap" Text="SET ANSI_NULLS / QUOTED_IDENTIFIER / ANSI_PADDING" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource OptionBox}" Content="CREATE vs ALTER vs CREATE OR ALTER" IsChecked="{Binding IgnoreCreateOrAlter}" />

                            <TextBlock Text="IN TABLES AND INDEXES" Style="{StaticResource SectionHeader}" />
                            <CheckBox Style="{StaticResource OptionBox}" IsChecked="{Binding IgnoreDefaultIndexOptions}">
                                <TextBlock TextWrapping="Wrap" Text="Default index options (PAD_INDEX = OFF, ALLOW_ROW_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF …)" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource OptionBox}" IsChecked="{Binding IgnoreAllIndexOptions}">
                                <TextBlock TextWrapping="Wrap" Text="All index options (FILLFACTOR, DATA_COMPRESSION …)" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource OptionBox}" Content="ON [PRIMARY] / TEXTIMAGE_ON [PRIMARY]" IsChecked="{Binding IgnoreDefaultFilegroup}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="All filegroups and partition schemes" IsChecked="{Binding IgnoreAllFilegroups}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="COLLATE on columns" IsChecked="{Binding IgnoreCollation}" />
                            <CheckBox Style="{StaticResource OptionBox}" IsChecked="{Binding IgnoreSystemNames}">
                                <TextBlock TextWrapping="Wrap" Text="System-generated constraint names (PK__Foo__3214EC07…)" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource OptionBox}" IsChecked="{Binding IgnoreRedundantParentheses}">
                                <TextBlock TextWrapping="Wrap" Text="Extra parentheses in defaults and checks (((0)) vs 0)" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource OptionBox}" Content="Constraint trust (WITH NOCHECK)" IsChecked="{Binding IgnoreConstraintTrust}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="AUTHORIZATION [dbo] on schemas" IsChecked="{Binding IgnoreSchemaOwnerDbo}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Column order" IsChecked="{Binding IgnoreColumnOrder}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Indexes" IsChecked="{Binding IgnoreIndexes}" />

                            <TextBlock Text="OBJECTS" Style="{StaticResource SectionHeader}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Extended properties" IsChecked="{Binding IgnoreExtendedProperties}" />
                            <CheckBox Style="{StaticResource OptionBox}" Content="Users, roles, logins and permissions" IsChecked="{Binding IgnoreSecurity}" />

                            <TextBlock Text="EXCLUDE OBJECTS" Style="{StaticResource SectionHeader}" />
                            <TextBox Text="{Binding ExcludeObjects}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="OnOptionTextChanged"
                                     Tag="HangFire.*" FontFamily="Cascadia Mono, Consolas"
                                     ToolTip="One per line, * and ? wildcards, over schema.name or Type:schema.name. For example HangFire.* or Table:dbo.__RefactorLog" />
                            <TextBlock Text="One per line, * and ? wildcards: HangFire.*  Table:dbo.Temp*" Style="{StaticResource Muted}" FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="EQUIVALENT NAMES" Style="{StaticResource SectionHeader}" />
                            <TextBox Text="{Binding EquivalentNames}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="OnOptionTextChanged"
                                     Tag="GENGER.Patient = GENGER-uat.Patient" FontFamily="Cascadia Mono, Consolas"
                                     ToolTip="Names that differ by environment, one pair per line: left = right. The right-hand name is read as the left-hand one." />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap"
                                       Text="left = right, one per line. A project's SQLCMD variable works too: GENGER.Patient = $(PatientDb)" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
