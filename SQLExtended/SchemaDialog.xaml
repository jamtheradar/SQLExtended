<Window x:Class="SQLExtended.SchemaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Schema Viewer"
        Width="750" Height="600"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SqlxSurface}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Button style matching SSMS dark theme -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SqlxControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource SqlxTextChrome}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SqlxBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SqlxControlHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SqlxAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SqlxControlPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark theme TabItem style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource SqlxSurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource SqlxTextSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SqlxBorder}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SqlxSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SqlxTextStrong}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SqlxAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SqlxControl}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SqlxTextChrome}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Object name -->
        <TextBlock Grid.Row="0"
                   x:Name="ObjectNameHeader"
                   Foreground="{DynamicResource SqlxHeading}"
                   FontFamily="Cascadia Code, Consolas, Courier New"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="4,4,4,8"/>

        <!-- Tabbed schema view: Schema and Temp Table (tables only) -->
        <TabControl Grid.Row="1" x:Name="SchemaTabs"
                    Background="{DynamicResource SqlxSurface}"
                    BorderBrush="{DynamicResource SqlxBorderSubtle}"
                    Margin="4">
            <TabItem Header="Schema" x:Name="SchemaTab">
                <avalonedit:TextEditor x:Name="SchemaTextBox"
                         IsReadOnly="True"
                         ShowLineNumbers="True"
                         WordWrap="False"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13"
                         Background="{DynamicResource SqlxSurface}"
                         Foreground="{DynamicResource SqlxText}"
                         LineNumbersForeground="{DynamicResource SqlxLineNumber}"
                         BorderThickness="0"
                         Padding="4"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
            <TabItem Header="Temp Table" x:Name="TempTableTab" Visibility="Collapsed">
                <avalonedit:TextEditor x:Name="TempTableTextBox"
                         IsReadOnly="True"
                         ShowLineNumbers="True"
                         WordWrap="False"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13"
                         Background="{DynamicResource SqlxSurface}"
                         Foreground="{DynamicResource SqlxText}"
                         LineNumbersForeground="{DynamicResource SqlxLineNumber}"
                         BorderThickness="0"
                         Padding="4"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>

        <!-- Bottom button bar -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="4,8,4,4">

            <Button Content="⟳ Refresh"
                    Style="{StaticResource ActionButton}"
                    Click="Refresh_Click"
                    ToolTip="Re-query the database for latest schema (clears cache)"
                    Margin="0,0,8,0"/>

            <Button Content="📋 Copy"
                    Style="{StaticResource ActionButton}"
                    Click="Copy_Click"
                    ToolTip="Copy schema script to clipboard (Ctrl+C also works)"
                    Margin="0,0,8,0"/>

            <Button Content="Open in Script Window"
                    Style="{StaticResource ActionButton}"
                    Click="OpenInScriptWindow_Click"
                    ToolTip="Open this script in a new query window on the same server and database (F12 from the editor skips this preview)"
                    Margin="0,0,8,0"/>

            <Button Content="Close"
                    Style="{StaticResource ActionButton}"
                    Click="Close_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
