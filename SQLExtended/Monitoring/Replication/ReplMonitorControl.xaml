<UserControl x:Class="SQLExtended.Monitoring.Replication.ReplMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SQLExtended.Monitoring.Replication"
             xmlns:mon="clr-namespace:SQLExtended.Monitoring"
             Background="{DynamicResource SqlxSurface}">

    <UserControl.Resources>
        <!-- Shared monitoring chrome: buttons, tabs, grid styling and converters. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SQLExtended;component/Monitoring/MonitoringTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Replication's own vocabulary: Idle is healthy, Inactive is not. -->
            <local:ReplStatusBrushConverter x:Key="AgentStatus"/>
            <local:ReplSubscriptionStatusBrushConverter x:Key="SubStatus"/>
            <local:ReplSeverityBrushConverter x:Key="Severity"/>
            <local:ReplHoursConverter x:Key="Hours"/>
            <local:ReplFractionConverter x:Key="Fraction"/>

            <!-- Flat buttons for the notice banner: they must not compete with the message for attention. -->
            <Style x:Key="NoticeButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource SqlxWarn}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SqlxWarnBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="7,1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SqlxWarnSurfaceStrong}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SqlxTextStrong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource ToolButton}" Click="Refresh_Click"
                        Padding="14,4" ToolTip="Read the current replication state now"/>
                <CheckBox x:Name="AutoRefreshCheck" Content="Auto" Style="{StaticResource ToolCheck}" Margin="8,0,0,0"
                          Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"
                          ToolTip="Poll the distribution database on a timer"/>
                <ComboBox x:Name="IntervalCombo" Style="{StaticResource ToolCombo}" Margin="6,0,0,0" Width="72"
                          SelectionChanged="Interval_Changed"
                          ToolTip="How often to poll while Auto is on"/>
                <Border Width="1" Background="{DynamicResource SqlxControlHover}" Margin="10,2,10,2"/>
                <Button x:Name="CopyButton" Content="Copy tab" Style="{StaticResource ToolButton}" Click="CopyTab_Click"
                        ToolTip="Copy the active tab's grid as tab-separated text"/>
                <Button x:Name="ScriptButton" Content="Open as query" Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                        Click="OpenAsQuery_Click"
                        ToolTip="Open the T-SQL behind the active tab in a new query window"/>
                <Border Width="1" Background="{DynamicResource SqlxControlHover}" Margin="10,2,10,2"/>
                <TextBlock Text="Filter" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="FilterBox" Width="170" Background="{DynamicResource SqlxControl}" Foreground="{DynamicResource SqlxTextChrome}" BorderBrush="{DynamicResource SqlxBorderStrong}"
                         FontSize="12" Padding="4,2" VerticalAlignment="Center" TextChanged="Filter_Changed"
                         ToolTip="Substring match on publication, publisher, subscriber and database"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                <TextBlock x:Name="ServerText" Foreground="{DynamicResource SqlxHeading}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LoginText" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" Margin="7,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: banner for "replication not configured", permission notes and per-section collection warnings -->
        <Border x:Name="NoticeBorder" Grid.Row="1" Background="{DynamicResource SqlxWarnSurface}" BorderBrush="{DynamicResource SqlxWarnBorder}" BorderThickness="1"
                CornerRadius="2" Padding="9,6" Margin="0,0,0,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NoticeText" Grid.Column="0" Foreground="{DynamicResource SqlxWarn}" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button x:Name="NoticeCopyButton" Grid.Column="1" Content="Copy" Style="{StaticResource NoticeButton}"
                        Margin="8,0,0,0" Click="NoticeCopy_Click"
                        ToolTip="Copy this message and its full detail to the clipboard"/>
                <Button x:Name="NoticeCloseButton" Grid.Column="2" Content="✕" Style="{StaticResource NoticeButton}"
                        Margin="4,0,0,0" Padding="6,1" Click="NoticeClose_Click" ToolTip="Dismiss this message"/>
            </Grid>
        </Border>

        <!-- Row 2: tabs, and under them the detail pane for the selected subscription, agent or error -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <!-- Zero until a row is clicked; the splitter then resizes it, and the height is kept when it is closed. -->
                <RowDefinition x:Name="DetailRow" Height="0"/>
            </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Background="{DynamicResource SqlxSurface}" BorderBrush="{DynamicResource SqlxBorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="0,6,0,0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabHeader}"/>
            </TabControl.ItemContainerStyle>

            <!-- ============================ Overview ============================ -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,4,2,2">
                    <StackPanel>
                        <!--
                            Verdict strip. Replication's state is spread across four history tables with numeric
                            status columns; this line is the one place that says whether any of it is a problem.
                        -->
                        <Border Background="{DynamicResource SqlxSurfaceAlt}" BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="3"
                                Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="STATUS" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="VerdictText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SqlxGood}"
                                               Text="Not collected yet"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="VerdictDetailText" Foreground="{DynamicResource SqlxTextChrome}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="RoleSummaryText" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="See diagnostics" Style="{StaticResource ToolButton}"
                                        VerticalAlignment="Center" Click="GoToDiagnostics_Click"
                                        ToolTip="Open the Diagnostics tab, which explains each finding and what to do about it"/>
                            </Grid>
                        </Border>

                        <!-- Role cards: replication is three roles that can all be on one instance. -->
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                            <Border Background="{DynamicResource SqlxSurfaceAlt}" BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="3"
                                    Padding="12,9" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="DISTRIBUTOR" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="DistributorText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SqlxText}"
                                               TextTrimming="CharacterEllipsis" Text="—"/>
                                    <TextBlock x:Name="DistributionDbText" Style="{StaticResource CardValue}" Margin="0,3,0,0" Text=""/>
                                    <TextBlock x:Name="RetentionText" Foreground="{DynamicResource SqlxTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SqlxSurfaceAlt}" BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="3"
                                    Padding="12,9" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PUBLICATIONS" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="PublicationCountText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SqlxSynIdentifier}" Text="—"/>
                                    <TextBlock x:Name="PublicationDetailText" Foreground="{DynamicResource SqlxTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SqlxSurfaceAlt}" BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="3"
                                    Padding="12,9" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="SUBSCRIPTIONS" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="SubscriptionCountText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SqlxSynIdentifier}" Text="—"/>
                                    <TextBlock x:Name="SubscriptionDetailText" Foreground="{DynamicResource SqlxTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SqlxSurfaceAlt}" BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="3"
                                    Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="WORST LATENCY" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="WorstLatencyText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SqlxSynFunction}" Text="—"/>
                                    <TextBlock x:Name="WorstLatencyDetailText" Foreground="{DynamicResource SqlxTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Subscriptions needing attention" Style="{StaticResource SectionHeading}"/>
                        <TextBlock x:Name="AttentionEmpty" Text="All subscriptions are healthy."
                                   Foreground="{DynamicResource SqlxGood}" FontSize="11" Margin="0,0,0,6"/>
                        <DataGrid x:Name="AttentionGrid" Style="{StaticResource MonitorGrid}" SelectedCellsChanged="DetailSource_SelectedCellsChanged" MaxHeight="260" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Publication" Binding="{Binding Publication}" Width="170"/>
                                <DataGridTextColumn Header="Subscriber" Binding="{Binding Subscriber}" Width="150"/>
                                <DataGridTextColumn Header="Subscriber DB" Binding="{Binding SubscriberDb, Converter={StaticResource Dash}}" Width="150"/>
                                <DataGridTemplateColumn Header="Agent" Width="110" SortMemberPath="RunStatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RunStatusText, Converter={StaticResource Dash}}" FontWeight="SemiBold"
                                                       Foreground="{Binding RunStatus, Converter={StaticResource AgentStatus}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total latency" Binding="{Binding TotalLatencySeconds, Converter={StaticResource Secs}}" Width="110"
                                                    ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Retention used" Binding="{Binding RetentionUsedFraction, Converter={StaticResource Fraction}}" Width="110"
                                                    ElementStyle="{StaticResource NumCell}"/>
                                <DataGridTextColumn Header="Last error / comment" Width="*"
                                                    Binding="{Binding LastError, Converter={StaticResource OneLine}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Diagnostics ============================ -->
            <!-- Derived client-side from the snapshot the other tabs are built from — no extra query. -->
            <TabItem Header="Diagnostics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <CheckBox x:Name="IssuesOnlyCheck" Content="Problems only" Style="{StaticResource ToolCheck}"
                                  Checked="IssuesOnly_Changed" Unchecked="IssuesOnly_Changed"
                                  ToolTip="Hide the informational rows and show only warnings and critical findings"/>
                        <TextBlock x:Name="IssuesHint" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="Evaluated from the current snapshot — nothing here costs an extra round trip."/>
                    </StackPanel>

                    <DataGrid x:Name="IssueGrid" Grid.Row="1" Style="{StaticResource MonitorGrid}" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="80" SortMemberPath="SeverityText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{Binding Severity, Converter={StaticResource Severity}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="110"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="280"/>
                            <DataGridTextColumn Header="Finding" Binding="{Binding Detail}" Width="440"/>
                            <DataGridTextColumn Header="What it means / what to do" Binding="{Binding Recommendation}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Recommendation}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ Subscriptions ============================ -->
            <TabItem Header="Subscriptions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <!--
                            On demand, never on the timer: MSdistribution_status counts rows in MSrepl_commands,
                            which is most expensive exactly when a backlog makes it most interesting.
                        -->
                        <Button x:Name="PendingButton" Content="Load pending commands" Style="{StaticResource ToolButton}"
                                Click="LoadPending_Click" Padding="14,4"
                                ToolTip="Count undelivered commands per subscription from MSdistribution_status"/>
                        <TextBlock x:Name="PendingHint" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="Pending counts load on demand — the count scans the command table, which is slowest when a backlog makes it most interesting."/>
                    </StackPanel>

                    <DataGrid x:Name="SubscriptionGrid" Grid.Row="1" Style="{StaticResource MonitorGrid}" SelectedCellsChanged="DetailSource_SelectedCellsChanged" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140"/>
                            <DataGridTextColumn Header="Publisher DB" Binding="{Binding PublisherDb}" Width="140"/>
                            <DataGridTextColumn Header="Publication" Binding="{Binding Publication}" Width="160"/>
                            <DataGridTextColumn Header="Subscriber" Binding="{Binding Subscriber}" Width="140"/>
                            <DataGridTextColumn Header="Subscriber DB" Binding="{Binding SubscriberDb, Converter={StaticResource Dash}}" Width="140"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SubscriptionType, Converter={StaticResource Dash}}" Width="80"/>

                            <DataGridTemplateColumn Header="Status" Width="95" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Inactive is the word that matters: expired, needs reinitializing. -->
                                        <TextBlock Text="{Binding Status, Converter={StaticResource Dash}}" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource SubStatus}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Agent" Width="100" SortMemberPath="RunStatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RunStatusText, Converter={StaticResource Dash}}" FontWeight="SemiBold"
                                                   Foreground="{Binding RunStatus, Converter={StaticResource AgentStatus}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- The two hops and their sum: which one is slow says where to look. -->
                            <DataGridTextColumn Header="Log reader" Binding="{Binding LogReaderLatencySeconds, Converter={StaticResource Secs}}" Width="95"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Distribution" Binding="{Binding DistributionLatencySeconds, Converter={StaticResource Secs}}" Width="100"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Total latency" Binding="{Binding TotalLatencySeconds, Converter={StaticResource Secs}}" Width="105"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTemplateColumn Header="Latency trend" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <mon:Sparkline Samples="{Binding LatencyHistory}" LineBrush="{DynamicResource SqlxSynFunction}" Height="16"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip="End-to-end latency over the polling window; the label is the window peak in seconds"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Undelivered" Binding="{Binding UndeliveredCommands, Converter={StaticResource Num}}" Width="105"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity, Converter={StaticResource Ts}}" Width="130"/>
                            <DataGridTextColumn Header="Retention used" Binding="{Binding RetentionUsedFraction, Converter={StaticResource Fraction}}" Width="110"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Retention" Binding="{Binding RetentionHours, Converter={StaticResource Hours}}" Width="95"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Delivered txns" Binding="{Binding DeliveredTransactions, Converter={StaticResource Num}}" Width="110"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Delivered cmds" Binding="{Binding DeliveredCommands, Converter={StaticResource Num}}" Width="115"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Job enabled" Binding="{Binding JobEnabled, Converter={StaticResource Glyph}}" Width="95"/>
                            <DataGridTextColumn Header="Job running" Binding="{Binding JobRunning, Converter={StaticResource Glyph}}" Width="95"/>
                            <DataGridTextColumn Header="Articles" Binding="{Binding ArticleCount}" Width="75"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Sync type" Binding="{Binding SyncType, Converter={StaticResource Dash}}" Width="110"/>
                            <DataGridTextColumn Header="Last comment" Binding="{Binding LastComment, Converter={StaticResource OneLine}}" Width="260"/>
                            <DataGridTextColumn Header="Last error" Binding="{Binding LastError, Converter={StaticResource OneLine}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ Publications ============================ -->
            <TabItem Header="Publications">
                <DataGrid x:Name="PublicationGrid" Style="{StaticResource MonitorGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150"/>
                        <DataGridTextColumn Header="Publisher DB" Binding="{Binding PublisherDb}" Width="150"/>
                        <DataGridTextColumn Header="Publication" Binding="{Binding Publication}" Width="190"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding PublicationType, Converter={StaticResource Dash}}" Width="110"/>
                        <DataGridTextColumn Header="Articles" Binding="{Binding ArticleCount}" Width="75"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Subscriptions" Binding="{Binding SubscriptionCount}" Width="100"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTemplateColumn Header="Last snapshot" Width="110" SortMemberPath="SnapshotStatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SnapshotStatusText, Converter={StaticResource Dash}}" FontWeight="SemiBold"
                                               Foreground="{Binding SnapshotStatus, Converter={StaticResource AgentStatus}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Snapshot at" Binding="{Binding SnapshotTime, Converter={StaticResource Ts}}" Width="130"/>
                        <!-- Retention is what the subscription expiry warnings are measured against. -->
                        <DataGridTextColumn Header="Retention" Binding="{Binding RetentionHours, Converter={StaticResource Hours}}" Width="95"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Immediate sync" Binding="{Binding ImmediateSync, Converter={StaticResource Glyph}}" Width="105"/>
                        <DataGridTextColumn Header="Independent agent" Binding="{Binding IndependentAgent, Converter={StaticResource Glyph}}" Width="125"/>
                        <DataGridTextColumn Header="Push" Binding="{Binding AllowPush, Converter={StaticResource Glyph}}" Width="60"/>
                        <DataGridTextColumn Header="Pull" Binding="{Binding AllowPull, Converter={StaticResource Glyph}}" Width="60"/>
                        <DataGridTextColumn Header="Anonymous" Binding="{Binding AllowAnonymous, Converter={StaticResource Glyph}}" Width="95"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description, Converter={StaticResource OneLine}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ============================ Agents ============================ -->
            <!--
                All four agent types in one list. The merge columns stay dashes for the other three — one grid
                beats four tabs when the question is "which agent is broken".
            -->
            <TabItem Header="Agents">
                <DataGrid x:Name="AgentGrid" Style="{StaticResource MonitorGrid}" SelectedCellsChanged="DetailSource_SelectedCellsChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Agent type" Binding="{Binding AgentTypeText}" Width="110"/>
                        <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="RunStatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RunStatusText, Converter={StaticResource Dash}}" FontWeight="SemiBold"
                                               Foreground="{Binding RunStatus, Converter={StaticResource AgentStatus}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, Converter={StaticResource Dash}}" Width="140"/>
                        <DataGridTextColumn Header="Publisher DB" Binding="{Binding PublisherDb, Converter={StaticResource Dash}}" Width="140"/>
                        <DataGridTextColumn Header="Publication" Binding="{Binding Publication, Converter={StaticResource Dash}}" Width="160"/>
                        <DataGridTextColumn Header="Subscriber" Binding="{Binding Subscriber, Converter={StaticResource Dash}}" Width="140"/>
                        <DataGridTextColumn Header="Subscriber DB" Binding="{Binding SubscriberDb, Converter={StaticResource Dash}}" Width="140"/>
                        <DataGridTextColumn Header="Latency" Binding="{Binding LatencySeconds, Converter={StaticResource Secs}}" Width="90"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity, Converter={StaticResource Ts}}" Width="130"/>
                        <DataGridTextColumn Header="Started" Binding="{Binding StartTime, Converter={StaticResource Ts}}" Width="130"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationSeconds, Converter={StaticResource Secs}}" Width="90"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Txns" Binding="{Binding DeliveredTransactions, Converter={StaticResource Num}}" Width="90"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Commands" Binding="{Binding DeliveredCommands, Converter={StaticResource Num}}" Width="100"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <!-- Merge only. -->
                        <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadedChanges, Converter={StaticResource Num}}" Width="95"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadedChanges, Converter={StaticResource Num}}" Width="100"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Conflicts" Binding="{Binding Conflicts, Converter={StaticResource Num}}" Width="90"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="Job enabled" Binding="{Binding JobEnabled, Converter={StaticResource Glyph}}" Width="95"/>
                        <DataGridTextColumn Header="Job running" Binding="{Binding JobRunning, Converter={StaticResource Glyph}}" Width="95"/>
                        <DataGridTextColumn Header="Job" Binding="{Binding JobName, Converter={StaticResource Dash}}" Width="200"/>
                        <DataGridTextColumn Header="Last comment" Binding="{Binding Comments, Converter={StaticResource OneLine}}" Width="280"/>
                        <DataGridTextColumn Header="Last error" Binding="{Binding LastError, Converter={StaticResource OneLine}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ============================ Publisher ============================ -->
            <!--
                Read from master, not from the distributor. log_reuse_wait_desc = REPLICATION is the reason this
                tab exists: it is the symptom of stalled replication that fills a disk, and nothing in the
                distribution database mentions it.
            -->
            <TabItem Header="Publisher">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,2,0,4">
                        <TextBlock Text="Replicated databases on this instance" Style="{StaticResource SectionHeading}" Margin="0,2,0,2"/>
                        <TextBlock x:Name="PublisherHint" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" TextWrapping="Wrap"
                                   Text="A log held by REPLICATION cannot be truncated until the log reader drains it — no log backup will help, and the log grows until the disk fills."/>
                    </StackPanel>

                    <DataGrid x:Name="PublisherGrid" Grid.Row="1" Style="{StaticResource MonitorGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="200"/>
                            <DataGridTextColumn Header="Published" Binding="{Binding IsPublished, Converter={StaticResource Glyph}}" Width="85"/>
                            <DataGridTextColumn Header="Merge published" Binding="{Binding IsMergePublished, Converter={StaticResource Glyph}}" Width="115"/>
                            <DataGridTextColumn Header="Subscribed" Binding="{Binding IsSubscribed, Converter={StaticResource Glyph}}" Width="90"/>
                            <DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryModel, Converter={StaticResource Dash}}" Width="100"/>
                            <DataGridTextColumn Header="Log reuse wait" Binding="{Binding LogReuseWait, Converter={StaticResource Dash}}" Width="150"/>
                            <DataGridTextColumn Header="Log used" Binding="{Binding LogPercentUsed, Converter={StaticResource Pct}}" Width="90"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Log size" Binding="{Binding LogSizeKb, Converter={StaticResource Kb}}" Width="100"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <!-- From sp_replcounters: the publisher's own view of the first hop. -->
                            <DataGridTextColumn Header="Waiting txns" Binding="{Binding ReplicatedTransactions, Converter={StaticResource Num}}" Width="105"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Replication rate" Binding="{Binding ReplicationRate, Converter={StaticResource PerSec}}" Width="115"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Replication latency" Binding="{Binding ReplicationLatencySeconds, Converter={StaticResource Secs}}" Width="125"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Sync with backup" Binding="{Binding IsSyncWithBackup, Converter={StaticResource Glyph}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,4">
                        <TextBlock Text="Subscriptions as the subscriber records them" Style="{StaticResource SectionHeading}" Margin="0,2,0,2"/>
                        <TextBlock Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" TextWrapping="Wrap"
                                   Text="From each subscribed database's own MSreplication_subscriptions table. For a pull subscription this is often the only progress record that does not depend on the distributor being reachable."/>
                    </StackPanel>

                    <DataGrid x:Name="SubscriberGrid" Grid.Row="3" Style="{StaticResource MonitorGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subscriber DB" Binding="{Binding SubscriberDb}" Width="180"/>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, Converter={StaticResource Dash}}" Width="150"/>
                            <DataGridTextColumn Header="Publisher DB" Binding="{Binding PublisherDb, Converter={StaticResource Dash}}" Width="150"/>
                            <DataGridTextColumn Header="Publication" Binding="{Binding Publication, Converter={StaticResource Dash}}" Width="170"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SubscriptionType, Converter={StaticResource Dash}}" Width="90"/>
                            <DataGridTextColumn Header="Last applied" Binding="{Binding LastApplied, Converter={StaticResource Ts}}" Width="140"/>
                            <DataGridTextColumn Header="Since" Binding="{Binding HoursSinceApplied, Converter={StaticResource Hours}}" Width="95"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Transaction timestamp" Binding="{Binding TransactionTimestamp, Converter={StaticResource Dash}}" Width="220"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, Converter={StaticResource OneLine}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ Tracer tokens ============================ -->
            <!--
                The only end-to-end measurement in replication that is not an estimate: a real transaction, timed
                as it lands. Posting one is a write, so it confirms first and only works from the publisher.
            -->
            <TabItem Header="Tracer tokens">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <Button x:Name="LoadTracerButton" Content="Load tokens" Style="{StaticResource ToolButton}"
                                Click="LoadTracer_Click" Padding="14,4"
                                ToolTip="Read the tracer tokens recorded in the distribution database"/>
                        <Border Width="1" Background="{DynamicResource SqlxControlHover}" Margin="10,2,10,2"/>
                        <TextBlock Text="Publication" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="TracerPublicationCombo" Style="{StaticResource ToolCombo}" Width="260"
                                  ToolTip="Which publication to post a token into. Only publications on this instance can be posted from here."/>
                        <Button x:Name="PostTracerButton" Content="Post tracer token" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                Click="PostTracer_Click"
                                ToolTip="Write a tracer token into the selected publication and time it end to end (confirms first)"/>
                        <TextBlock x:Name="TracerHint" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="A token takes a moment to arrive — post one, then load again."/>
                    </StackPanel>

                    <DataGrid x:Name="TracerGrid" Grid.Row="1" Style="{StaticResource MonitorGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Posted" Binding="{Binding PublisherCommit, Converter={StaticResource Ts}}" Width="140"/>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, Converter={StaticResource Dash}}" Width="140"/>
                            <DataGridTextColumn Header="Publisher DB" Binding="{Binding PublisherDb, Converter={StaticResource Dash}}" Width="140"/>
                            <DataGridTextColumn Header="Publication" Binding="{Binding Publication, Converter={StaticResource Dash}}" Width="170"/>
                            <DataGridTextColumn Header="Subscriber" Binding="{Binding Subscriber, Converter={StaticResource Dash}}" Width="140"/>
                            <DataGridTextColumn Header="Subscriber DB" Binding="{Binding SubscriberDb, Converter={StaticResource Dash}}" Width="140"/>
                            <DataGridTextColumn Header="Publisher → distributor" Binding="{Binding PublisherToDistributorSeconds, Converter={StaticResource Secs}}" Width="150"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Distributor → subscriber" Binding="{Binding DistributorToSubscriberSeconds, Converter={StaticResource Secs}}" Width="160"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalSeconds, Converter={StaticResource Secs}}" Width="90"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Reached distributor" Binding="{Binding DistributorCommit, Converter={StaticResource Ts}}" Width="140"/>
                            <DataGridTextColumn Header="Reached subscriber" Binding="{Binding SubscriberCommit, Converter={StaticResource Ts}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ Errors ============================ -->
            <TabItem Header="Errors">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,6">
                        <Button x:Name="LoadErrorsButton" Content="Load recent errors" Style="{StaticResource ToolButton}"
                                Click="LoadErrors_Click" Padding="14,4"
                                ToolTip="Read MSrepl_errors, the table the agent history rows only reference by id"/>
                        <ComboBox x:Name="ErrorCountCombo" Style="{StaticResource ToolCombo}" Margin="6,0,0,0" Width="90"
                                  ToolTip="How many of the most recent errors to return"/>
                        <TextBlock x:Name="ErrorsHint" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="Loads on demand. Click a row for the whole error chain, the agent's history and the command it stopped on."/>
                    </StackPanel>

                    <DataGrid x:Name="ErrorGrid" Grid.Row="1" Style="{StaticResource MonitorGrid}" SelectedCellsChanged="DetailSource_SelectedCellsChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Time, Converter={StaticResource Ts}}" Width="145"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding ErrorCode, Converter={StaticResource Dash}}" Width="130"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceName, Converter={StaticResource Dash}}" Width="200"/>
                            <DataGridTextColumn Header="Transaction seqno" Binding="{Binding XactSeqno, Converter={StaticResource Dash}}" Width="200"/>
                            <DataGridTextColumn Header="Command" Binding="{Binding CommandId, Converter={StaticResource Dash}}" Width="95"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Session" Binding="{Binding SessionId, Converter={StaticResource Dash}}" Width="85"
                                                ElementStyle="{StaticResource NumCell}"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding ErrorText, Converter={StaticResource OneLine}}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding ErrorText}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

            <GridSplitter x:Name="DetailSplitter" Grid.Row="1" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Visibility="Collapsed"
                          ToolTip="Drag to resize the detail pane"/>

            <!--
                Detail pane. The grids can only show the latest history row's one-line error; troubleshooting needs
                the whole MSrepl_errors chain (one failure writes several rows under one id), the agent's recent
                history, and the command it stopped on, decoded by sp_browsereplcmds with the row's values in it.
                Loaded on the click, never on the timer.
            -->
            <Border x:Name="DetailPane" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource SqlxSurfaceAlt}"
                    BorderBrush="{DynamicResource SqlxBorder}" BorderThickness="1" CornerRadius="3" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DetailTitle" Foreground="{DynamicResource SqlxTextStrong}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DetailSubtitle" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Content="Copy details" Style="{StaticResource ToolButton}" Click="DetailCopy_Click"
                                    ToolTip="Copy the error chain, the failing command and the agent history as text"/>
                            <Button Content="Open as query" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="DetailOpenAsQuery_Click"
                                    ToolTip="Open the T-SQL behind this pane in a new query window (run it against the distributor)"/>
                            <Button Content="✕" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Padding="8,4" Click="DetailClose_Click"
                                    ToolTip="Close the detail pane"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="200"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="40"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="40"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,3">
                                <TextBlock Text="ERROR" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DetailErrorWhen" Foreground="{DynamicResource SqlxTextMuted}" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBox x:Name="DetailErrorText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource SqlxSurface}" Foreground="{DynamicResource SqlxText}"
                                     BorderBrush="{DynamicResource SqlxBorderSubtle}" FontSize="12" Padding="4,3"/>

                            <StackPanel Grid.Row="2" Margin="0,8,0,3">
                                <TextBlock Text="FAILING COMMAND" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="DetailCommandSummary" Foreground="{DynamicResource SqlxTextChrome}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="DetailCommandText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource SqlxSurface}" Foreground="{DynamicResource SqlxText}"
                                     BorderBrush="{DynamicResource SqlxBorderSubtle}" FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12" Padding="4,3"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,3">
                                <TextBlock Text="AGENT HISTORY" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="click a red row to see that error" Foreground="{DynamicResource SqlxTextMuted}" FontSize="10"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="DetailHistoryGrid" Grid.Row="1" Style="{StaticResource MonitorGrid}" SelectionUnit="FullRow"
                                      SelectionMode="Single" SelectionChanged="DetailHistory_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding Time, Converter={StaticResource Ts}}" Width="130"/>
                                    <DataGridTemplateColumn Header="Status" Width="80" SortMemberPath="RunStatusText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RunStatusText, Converter={StaticResource Dash}}" FontWeight="SemiBold"
                                                           Foreground="{Binding RunStatus, Converter={StaticResource AgentStatus}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Cmds" Binding="{Binding DeliveredCommands, Converter={StaticResource Num}}" Width="70"
                                                        ElementStyle="{StaticResource NumCell}"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Comments, Converter={StaticResource OneLine}}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="ToolTip" Value="{Binding Comments}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: status bar -->
        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{DynamicResource SqlxTextMuted}" FontSize="11"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Text="Open a query window connected to the distributor (or a publisher), then press Refresh."/>
            <TextBlock x:Name="TimingText" Grid.Column="1" Foreground="{DynamicResource SqlxHeading}" FontSize="11" Margin="8,0,2,0"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
